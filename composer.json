{
    "name": "invoiceshelf/module-hello-world",
    "description": "Official Hello World reference module for InvoiceShelf",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "InvoiceShelf",
            "email": "hello@invoiceshelf.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "invoiceshelf/modules": "^3.2"
    },
  "require-dev": {
    "laravel/pint": "^1.26",
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\HelloWorld\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\HelloWorld\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test"
    },
  "config": {
    "allow-plugins": {
      "wikimedia/composer-merge-plugin": true
    },
    "sort-packages": true
    },
    "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": {
    "invoiceshelf-modules": {
            "type": "vcs",
            "url": "https://github.com/InvoiceShelf/modules.git"
        }
    }
}
